# Black Box — Gemma inference configuration.
# Default: local mode. Gemma 4 runs on your machine via Ollama and
# inference text never leaves the device.

GEMMA_PROVIDER=local

# Local mode (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Hosted demo mode (OpenAI-compatible endpoint serving Gemma 4).
# Used on Render, which has no GPU. The UI labels this "Demo mode".
# GEMMA_PROVIDER=hosted
# GEMMA_HOSTED_BASE_URL=https://openrouter.ai/api/v1
# GEMMA_HOSTED_MODEL=google/gemma-4-26b-a4b-it:free
# GEMMA_HOSTED_API_KEY=

# Development without a model:
# GEMMA_PROVIDER=mock
